# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Amazon discovery ---
# AMAZON_PROVIDER selects the real data source: "playwright" (real browser,
# no API key needed — see docs/PROVIDERS.md), "mock" (force demo data), or
# leave blank to use SerpApi (below) when SERPAPI_API_KEY is set.
AMAZON_PROVIDER=
SERPAPI_API_KEY=

# --- Lead / email enrichment ---
# LEAD_PROVIDER selects the real company/decision-maker data source:
# "playwright" (real browser against the company's own public website, no
# API key, no LinkedIn automation — see docs/PROVIDERS.md), "mock" (force
# demo data), or leave blank to use Hunter/Apollo (below) when configured.
LEAD_PROVIDER=
HUNTER_API_KEY=
APOLLO_API_KEY=

# --- Google Sheets export ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- n8n ---
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# --- AI provider ---
AI_PROVIDER=mock
AI_API_KEY=

# --- Safety switches (defaults are the only safe defaults) ---
DEMO_MODE=true
PAID_APIS_ENABLED=false

# --- Development-only account (npm run seed:developer) ---
# Leave blank to use the script's built-in local-dev defaults. Never set a
# real/production password here — this account is for local testing only.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
