  },
  "nodes": [
    {
      "parameters": {
        "path": "export-google-sheets",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "name": "Webhook: Export Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$env.GOOGLE_CLIENT_ID}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "leftValue": "={{$env.GOOGLE_CLIENT_SECRET}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
