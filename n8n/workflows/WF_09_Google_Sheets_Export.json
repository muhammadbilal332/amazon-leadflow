            {
              "leftValue": "={{$env.GOOGLE_REFRESH_TOKEN}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "options": {
            "combinator": "and"
          }
        }
      },
      "name": "Google Sheets Configured?",
