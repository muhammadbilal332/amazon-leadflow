    {
      "parameters": {
        "jsCode": "const ctx = $('Start (called by WF_01)').first().json;\nconst dmRows = $input.all().map(i => i.json);\nconst rows = dmRows.map(dmRow => {\n  const original = (ctx.decisionMakers||[]).find(dm => dm.name === dmRow.name && dm.jobTitle === dmRow.job_title);\n  return {\n    decision_maker_id: dmRow.id,\n    email: original?.email ?? null,\n    email_status: original?.emailStatus ?? 'NOT_CHECKED',\n    email_verified_at: original?.emailVerifiedAt ?? null,\n    source: (original && original.source) || 'n8n',\n  };\n});\nreturn [{ json: { rows } }];"
      },
