      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst c = ctx.company || {};\nreturn [{ json: { rows: [{\n  brand_id: ctx.brandId, name: c.name, domain: c.domain, website: c.website,\n  description: c.description, employee_range: c.employeeRange, location: c.location,\n  source: c.source || 'n8n',\n  linkedin_url: c.linkedinUrl ?? null, industry: c.industry ?? null, founded_year: c.foundedYear ?? null,\n  contact_url: c.contactUrl ?? null, public_business_email: c.publicBusinessEmail ?? null, public_business_phone: c.publicBusinessPhone ?? null,\n}] } }];"
      },
